# Copy to nebius.env and fill in your VM. nebius.env is gitignored.
# Sourced by nebius.sh — edit values here, never hard-code them in the scripts.

# --- VM connection ---
export NB_HOST=0.0.0.0                       # public IP (nebius.sh refresh-ip keeps this current)
export NB_USER=ubuntu                        # login user created by the instance's cloud-init
export NB_SSH_KEY="$HOME/.ssh/id_ed25519"    # private key registered on the VM

# Nebius instance identity (for `nebius.sh start|stop|refresh-ip` via the Nebius CLI)
export NB_INSTANCE_ID=computeinstance-xxxxxxxxxxxxxxxxxxxx
export NB_PROJECT_ID=project-xxxxxxxxxxxxxxxxxxxx
export NB_REMOTE_DIR=robot                   # working dir on the VM, relative to $HOME

# --- LeRobot version pinning (must match the version your datasets were recorded with) ---
export LEROBOT_REPO=https://github.com/huggingface/lerobot.git
export LEROBOT_COMMIT=b06ad408               # lerobot 0.5.2; not on PyPI, so the VM clones + checks out

# --- Training defaults (override on the `nebius.sh train` command line) ---
export POLICY_TYPE=act
export DEFAULT_STEPS=60000
export DEFAULT_BATCH=64

# HF_USER comes from ../env.sh, HF_TOKEN from ../.env
